DATABASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI: any OpenAI-compatible chat API. Defaults to Groq (free key at console.groq.com).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODEL=qwen/qwen3.8-27b

# Carrier tracking (EasyPost test key, starts with EZTK).
EASYPOST_API_KEY=

# Buyer email (SMTP). Port 587 = STARTTLS, 465 = SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Sandbox: send every buyer email to your own inbox (sandbox buyer addresses don't receive mail).
EMAIL_REDIRECT_TO=
STORE_NAME=Forestall Demo Shop

# Store connection: the webhook secret you choose in WooCommerce.
WOOCOMMERCE_WEBHOOK_SECRET=
